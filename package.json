{
  "name": "seeded-maze",
  "version": "0.3.0",
  "description": "Engine-agnostic, deterministic maze generation: seeded grid mazes, rail-node geometry, multi-layer topology with provable solvability, and curved-wall outlines.",
  "keywords": [
    "maze",
    "maze-generator",
    "procedural-generation",
    "seeded",
    "deterministic",
    "game-dev",
    "level-generation",
    "labyrinth",
    "typescript"
  ],
  "homepage": "https://jonbogaty.com/seeded-maze/",
  "bugs": {
    "url": "https://github.com/jbcom/seeded-maze/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbcom/seeded-maze.git"
  },
  "license": "MIT",
  "author": "Jon Bogaty <jon@jonbogaty.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "dist",
    "!docs/dist",
    "docs/API.md",
    "docs/ARCHITECTURE.md",
    "examples",
    "llms.txt"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "coverage": "vitest run --coverage",
    "docs:build": "pnpm --filter seeded-maze-docs build",
    "docs:check": "pnpm --filter seeded-maze-docs check",
    "docs:dev": "pnpm --filter seeded-maze-docs dev",
    "examples:check": "node examples/basic.mjs && node examples/commonjs.cjs",
    "lint": "biome check .",
    "lint:docs": "markdownlint-cli2 README.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md CHANGELOG.md AGENTS.md \"docs/**/*.md\" \"!docs/node_modules/**\" \"!docs/dist/**\" .github/PULL_REQUEST_TEMPLATE.md",
    "lint:fix": "biome check --write .",
    "package:check": "publint && attw --pack . && node scripts/verify-package.mjs",
    "prepack": "node scripts/build.mjs",
    "prepare": "simple-git-hooks",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "pnpm run lint && pnpm run lint:docs && pnpm run typecheck && pnpm run coverage && pnpm run build && pnpm run examples:check && pnpm run package:check"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "markdownlint-cli2"
    ]
  },
  "dependencies": {
    "seedrandom": "^3.0.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^24.13.3",
    "@types/seedrandom": "^3.0.8",
    "@vitest/coverage-v8": "^5.0.3",
    "lint-staged": "^17.3.0",
    "markdownlint-cli2": "^0.24.0",
    "publint": "^0.3.24",
    "simple-git-hooks": "^2.13.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.10.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
